project CosinusOS is
   -- Minimalna konfiguracja do testu

   for Source_Dirs use (".", "src");   -- szuka źródeł rekurencyjnie
   for Object_Dir use "obj";                               -- obiekty tutaj (nie zaśmieca repo)
   for Exec_Dir   use "bin";

   for Languages use ("Ada", "Assembly");                  -- dodaj później więcej jeśli potrzeba

   -- Podstawowe opcje kompilacji (debug)
   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnatwa");   -- debug + wszystkie warningi
   end Compiler;

end CosinusOS;